{
  "topology": "mesh",
  "config_refresh": "5m",
  "hide_skipped": false,
  "hosts": [
    { "name": "mikrotik-rb4011", "address": "2001:db8:1:2::probe", "site": "site-a" },
    { "name": "probe-b",         "address": "fd7a:115c:a1e0:809::12", "site": "site-b" }
  ],
  "hub_spoke": { "enabled": false, "hub": "" },
  "measurements": [
    {
      "type": "twamp", "interval": "300s", "targets": "all",
      "burst_size": 5, "burst_interval": "200ms", "packet_timeout": "5s"
    },
    {
      "type": "bw", "interval": "1200s", "targets": "all",
      "duration": "10s", "prefer_iperf3": false
    },
    {
      "type": "trace", "interval": "1200s", "targets": "all",
      "max_hops": 30, "probes_per_hop": 1, "timeout": "2s"
    },
    {
      "type": "mtu", "interval": "1200s", "targets": "all", "ceiling": 1500
    },
    {
      "type": "dns", "interval": "300s",
      "resolvers": ["2620:fe::fe", "2606:4700:4700::1111"],
      "names": ["example.com"]
    }
  ],
  "influxdb": { "url": "", "token": "", "org": "", "bucket": "" },
  "local_store": { "enabled": false, "path": "/tmp/piccolo-results.jsonl", "max_lines": 5000 }
}
